{
  "name": "bhatkhande-flow",
  "version": "1.0.0",
  "description": "VexFlow-style rendering engine for Bhatkhande (Hindustani) notation. Input: bandish JSON/XML. Output: SVG + dataset labels.",
  "type": "module",
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/INPUT_FORMATS.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "render": "tsx cli/render.ts",
    "build:web": "node scripts/build-web.mjs",
    "web": "node scripts/build-web.mjs && node scripts/serve.mjs",
    "test:browser": "node scripts/build-web.mjs && node test/browser/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "fontkit": "^2.0.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "bhatkhande",
    "hindustani",
    "notation",
    "music",
    "svg",
    "omr",
    "dataset",
    "vexflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atharav443/bhatkhande-flow.git"
  }
}
